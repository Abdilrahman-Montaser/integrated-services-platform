@model LoginVM
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="container-tw py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="tw-card tw-card-pad">
                <div class="mb-4">
                    <span class="eyebrow">TADWEER HUB · ACCESS</span>
                    <h1 class="h3 mt-1 mb-1">تسجيل الدخول</h1>
                    <p class="text-muted-tw fs-13 mb-0">ادخل بيانات حسابك لمتابعة اللوطات والطلبات والمحفظة.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger fs-13 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" placeholder="name@company.com" dir="ltr" />
                        <span asp-validation-for="Email" class="text-danger fs-12"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">كلمة المرور</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" dir="ltr" />
                        <span asp-validation-for="Password" class="text-danger fs-12"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label fs-13">تذكّرني</label>
                        </div>
                        <span class="fs-12 text-faint">تجريبي: اكتب factory أو driver أو admin في الإيميل</span>
                    </div>

                    <button type="submit" class="btn btn-tw-primary w-100 btn-lg">
                        <i class="bi bi-box-arrow-in-left"></i> دخول للمنصة
                    </button>
                </form>

                <div class="rule"></div>

                <div class="text-center fs-14">
                    لسه معندكش حساب؟
                    <a asp-controller="Account" asp-action="Register" class="fw-semibold">إنشاء حساب جديد</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}