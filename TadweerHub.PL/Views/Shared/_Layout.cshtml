@using TadweerHub.PL.Mock
@{
    var role = MockSession.Role(Context);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // صفحات الزوّار (الرئيسية والحساب) دايماً بالـ Navbar العادي.
    // باقي الصفحات: لو فيه مستخدم داخل بيتعرض الـ Sidebar، ولو زائر الـ Navbar.
    var publicPage = controller is "Home" or "Account";
    var useShell = role != "guest" && !publicPage;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - تدوير هب</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/tadweer.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (useShell)
    {
        <div class="app">
            <partial name="_Sidebar" />
            <main class="main">
                <partial name="_Topbar" />
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <partial name="_Navbar" />
        @RenderBody()
        <partial name="_Footer" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
